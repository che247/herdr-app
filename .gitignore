# Herdr writes its own state into this folder and rewrites its shipped
# layouts and mods on every start, so only personal files are tracked.
/*
!.gitignore
!.gitattributes
!README.md
!keys.json
!settings.json
!programs.json
!wsl-shell.toml
!scripts/
!opencode/

# Layouts
!layouts/
layouts/*
!layouts/traveler.json
!layouts/user-main.json
!layouts/user-main.svg

# Theme
!themes/
themes/*
!themes/traveler-dusk.json

# Personal mods (Herdr's shipped mods are restored on every start)
!mods/
mods/*
!mods/traveler-*/
!mods/user-*/

# Generated by Herdr inside mod folders
**/gpui-kit.d.ts
**/herdr.d.ts
**/jsconfig.json
*.error
*.before-*
*.bak*

# Personal macOS pixel layout and supporting tools
!layouts/pixel-art.json
!mods/pixel-*/
!mods/name-new-tab/
!mods/name-pane/
!mods/confirm-close-pane/
!pixel-icons/
!codex-usage.py
!tests/
**/__pycache__/
