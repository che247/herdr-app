{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "pixel-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "pixel-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "pixel-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "pixel-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 340
      },
      "min": 44,
      "max": 480,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "pixel-tabs"
          },
          "size": {
            "px": 44
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pixel-pane"
                    },
                    "reveal": "always",
                    "height": 32,
                    "position": "top"
                  },
                  "background": "#1a1c2c00",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 2,
                    "color": "accent"
                  },
                  "radius": 4,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "user-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "pixel-status"
          },
          "size": {
            "px": 30
          }
        },
        {
          "id": "layout-cleanup",
          "type": "block",
          "content": {
            "mod": "user-hide-layouts"
          },
          "size": {
            "px": 0
          },
          "min": 0,
          "max": 0
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "pixel-icons/bg-night.png",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "resizable": true,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "pixel-art",
  "terminal_opacity": 0.86,
  "preview": "pixel-icons/pixel-art-preview.png"
}
